{
  "name": "passes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Run Markdown-defined Codex stages in concurrent layers in the current checkout",
  "bin": {
    "passes": "./src/cli.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "build": "bun build ./src/cli.ts --target=bun --outfile=dist/passes.js",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test && bun run build",
    "repos:sync": "bun scripts/sync-repos.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.1",
    "effect": "4.0.1",
    "gray-matter": "4.0.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
